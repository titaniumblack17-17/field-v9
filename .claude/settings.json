{
  "permissions": {
    "deny": [
      "Read(./graphify-out/graph.json)",
      "Read(./graphify-out/manifest.json)",
      "Read(./graphify-out/cache/**)",
      "Read(./graphify-out/*/graph.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ]
  }
}